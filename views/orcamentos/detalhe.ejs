<% const cores = { aberto: 'secondary', aprovado: 'primary', recusado: 'danger', convertido: 'success' }; %>
<div class="pagina-titulo">
  <div>
    <h1>Orçamento <%= orcamento.numero %></h1>
    <p><%= orcamento.cliente %> · válido até <%= formato.data(orcamento.validade) %></p>
  </div>
  <div class="d-flex gap-2 align-items-center">
    <span class="badge text-bg-<%= cores[orcamento.status] %>"><%= orcamento.status %></span>
    <a href="/orcamentos" class="btn btn-outline-secondary">Voltar</a>
  </div>
</div>

<%- include('../partials/alertas') %>

<div class="card mb-3">
  <div class="table-responsive">
    <table class="table mb-0">
      <thead><tr><th>Código</th><th>Produto</th><th class="text-end">Qtd.</th><th class="text-end">Preço un.</th><th class="text-end">Subtotal</th></tr></thead>
      <tbody>
        <% orcamento.itens.forEach(function (item) { %>
          <tr>
            <td><code><%= item.codigo %></code></td>
            <td><%= item.descricao %></td>
            <td class="text-end"><%= formato.quantidade(item.quantidade) %> <%= item.unidade %></td>
            <td class="text-end"><%= formato.moeda(item.preco_unitario) %></td>
            <td class="text-end"><%= formato.moeda(item.quantidade * item.preco_unitario) %></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr><th colspan="4" class="text-end">Total</th><th class="text-end"><%= formato.moeda(orcamento.total) %></th></tr>
      </tfoot>
    </table>
  </div>
</div>

<% if (orcamento.observacao) { %>
  <div class="alert alert-light border"><strong>Observação:</strong> <%= orcamento.observacao %></div>
<% } %>

<div class="d-flex flex-wrap gap-2">
  <% if (orcamento.status === 'aberto') { %>
    <form method="post" action="/orcamentos/<%= orcamento.id %>/status">
      <input type="hidden" name="status" value="aprovado">
      <button class="btn btn-primary"><i class="bi bi-hand-thumbs-up"></i> Aprovar</button>
    </form>
    <form method="post" action="/orcamentos/<%= orcamento.id %>/status">
      <input type="hidden" name="status" value="recusado">
      <button class="btn btn-outline-danger">Recusar</button>
    </form>
  <% } %>

  <% if (orcamento.status === 'aprovado') { %>
    <form method="post" action="/orcamentos/<%= orcamento.id %>/converter" class="d-flex gap-2 align-items-center">
      <select name="forma_pagamento" class="form-select">
        <option value="dinheiro">Dinheiro</option>
        <option value="pix">PIX</option>
        <option value="cartao">Cartão</option>
        <option value="boleto">Boleto 28 dias</option>
      </select>
      <button class="btn btn-success text-nowrap"><i class="bi bi-cart-check"></i> Converter em venda</button>
    </form>
  <% } %>
</div>
