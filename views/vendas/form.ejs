<div class="pagina-titulo">
  <div><h1>Nova venda</h1><p>Venda de balcão: confirma e baixa o estoque na hora</p></div>
  <a href="/vendas" class="btn btn-outline-secondary">Voltar</a>
</div>

<form method="post" action="/vendas">
  <div class="card card-body mb-3">
    <div class="row g-3">
      <div class="col-md-8">
        <label class="form-label">Cliente</label>
        <select name="cliente_id" class="form-select" required>
          <% clientes.forEach(function (cliente) { %>
            <option value="<%= cliente.id %>"><%= cliente.nome %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Forma de pagamento</label>
        <select name="forma_pagamento" class="form-select">
          <option value="dinheiro">Dinheiro</option>
          <option value="pix">PIX</option>
          <option value="cartao">Cartão</option>
          <option value="boleto">Boleto 28 dias</option>
        </select>
      </div>
    </div>
  </div>

  <%- include('../partials/editor-itens') %>

  <div class="mt-3">
    <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Confirmar venda</button>
  </div>
</form>
