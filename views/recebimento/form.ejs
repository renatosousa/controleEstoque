<div class="pagina-titulo">
  <div>
    <h1>Recebimento de mercadoria</h1>
    <p>Importe o XML da NF-e do fornecedor para dar entrada automática no estoque</p>
  </div>
</div>

<%- include('../partials/alertas') %>

<div class="row g-3">
  <div class="col-lg-6">
    <form method="post" action="/recebimento/importar" enctype="multipart/form-data" class="card card-body h-100">
      <div class="mb-3">
        <label class="form-label">Arquivo XML da NF-e</label>
        <input type="file" name="xml" accept=".xml,text/xml,application/xml" class="form-control">
      </div>
      <div class="mb-3">
        <label class="form-label">ou cole o conteúdo do XML</label>
        <textarea name="xml_texto" rows="6" class="form-control" placeholder="&lt;nfeProc&gt;..."></textarea>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary"><i class="bi bi-box-arrow-in-down"></i> Importar e dar entrada</button>
        <button class="btn btn-outline-secondary" name="usar_exemplo" value="1">Usar XML de exemplo</button>
      </div>
      <div class="form-text mt-2">
        Produtos ainda não cadastrados são criados automaticamente a partir do XML, com preço de venda
        sugerido em 45% sobre o custo.
      </div>
    </form>
  </div>

  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-white fw-semibold">Entradas já recebidas</div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead><tr><th>NF-e</th><th>Fornecedor</th><th>Data</th><th class="text-end">Valor</th></tr></thead>
          <tbody>
            <% if (!entradas.length) { %>
              <tr><td colspan="4" class="text-muted">Nenhuma nota de entrada importada.</td></tr>
            <% } %>
            <% entradas.forEach(function (entrada) { %>
              <tr>
                <td><a href="/notas/<%= entrada.id %>"><%= entrada.numero %></a></td>
                <td><%= entrada.fornecedor || '-' %></td>
                <td><%= formato.dataHora(entrada.emitida_em) %></td>
                <td class="text-end"><%= formato.moeda(entrada.valor_total) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
