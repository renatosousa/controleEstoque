<div class="pagina-titulo">
  <div><h1>Estoque</h1><p>Saldos calculados a partir dos movimentos de entrada, saída e ajuste</p></div>
  <a href="/recebimento" class="btn btn-outline-primary"><i class="bi bi-box-arrow-in-down"></i> Receber por NF-e</a>
</div>

<%- include('../partials/alertas') %>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header bg-white fw-semibold">Saldos</div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead><tr><th>Código</th><th>Produto</th><th class="text-end">Saldo</th><th class="text-end">Mínimo</th><th class="text-end">Valor em estoque</th></tr></thead>
          <tbody>
            <% produtos.forEach(function (produto) { %>
              <tr>
                <td><code><%= produto.codigo %></code></td>
                <td><%= produto.descricao %></td>
                <td class="text-end <%= produto.saldo < produto.estoque_minimo ? 'text-danger fw-semibold' : '' %>">
                  <%= formato.quantidade(produto.saldo) %> <%= produto.unidade %>
                </td>
                <td class="text-end text-muted"><%= formato.quantidade(produto.estoque_minimo) %></td>
                <td class="text-end"><%= formato.moeda(produto.saldo * produto.preco_custo) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header bg-white fw-semibold">Lançamento manual</div>
      <form method="post" action="/estoque/movimentos" class="card-body">
        <div class="mb-3">
          <label class="form-label">Produto</label>
          <select name="produto_id" class="form-select" required>
            <% produtos.forEach(function (produto) { %>
              <option value="<%= produto.id %>"><%= produto.codigo %> · <%= produto.descricao %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Tipo</label>
          <select name="tipo" class="form-select">
            <option value="entrada">Entrada</option>
            <option value="saida">Saída</option>
            <option value="ajuste">Ajuste (inventário)</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Quantidade</label>
          <input type="number" step="0.01" name="quantidade" class="form-control" required>
          <div class="form-text">Em ajustes, use valor negativo para reduzir o saldo.</div>
        </div>
        <div class="mb-3">
          <label class="form-label">Observação</label>
          <input name="observacao" class="form-control" placeholder="Ex.: quebra, inventário, devolução">
        </div>
        <button class="btn btn-primary w-100"><i class="bi bi-check-lg"></i> Lançar</button>
      </form>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header bg-white fw-semibold">Kardex (últimos movimentos)</div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead><tr><th>Data</th><th>Produto</th><th>Tipo</th><th class="text-end">Qtd.</th><th class="text-end">Custo un.</th><th>Documento</th><th>Observação</th></tr></thead>
          <tbody>
            <% movimentos.forEach(function (mov) { %>
              <tr>
                <td><%= formato.dataHora(mov.criado_em) %></td>
                <td><%= mov.codigo %> · <%= mov.descricao %></td>
                <td><span class="badge text-bg-<%= mov.tipo === 'entrada' ? 'success' : (mov.tipo === 'saida' ? 'danger' : 'warning') %>"><%= mov.tipo %></span></td>
                <td class="text-end"><%= formato.quantidade(mov.quantidade) %> <%= mov.unidade %></td>
                <td class="text-end"><%= formato.moeda(mov.custo_unitario) %></td>
                <td><%= mov.documento || '-' %></td>
                <td class="small text-muted"><%= mov.observacao || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
